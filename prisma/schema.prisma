// Modèle de données — Phase 1 (F1 : authentification, invitations, rôles).
// SQLite en développement ; le schéma est compatible PostgreSQL (exigence 8.1)
// en remplaçant simplement DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                String    @id @default(cuid())
  prenom            String
  nom               String
  email             String    @unique
  passwordHash      String
  role              String // "PROFESSEUR" | "ELEVE" (pas d'enum en SQLite)
  actif             Boolean   @default(true)
  derniereConnexion DateTime?
  tentativesEchouees Int      @default(0)
  verrouilleJusqua  DateTime?
  createdAt         DateTime  @default(now())

  sessions          Session[]
  connexions        LoginEvent[]
  reinitialisations PasswordReset[]
  codes2FA          TwoFactorCode[]
  invitationsCrees Invitation[]       @relation("InvitationCreateur")
  invitationUtilisee Invitation?      @relation("InvitationUtilisateur")
  progressions      Progression[]
  consultations     Consultation[]
  messagesEnvoyes   Message[]  @relation("MessageAuteur")
  conversations     Message[]  @relation("MessageConversation")
}

model Invitation {
  id          String    @id @default(cuid())
  code        String    @unique
  expireLe    DateTime
  utilisee    Boolean   @default(false)
  revoquee    Boolean   @default(false)
  emailInvite String?
  createdAt   DateTime  @default(now())

  createdById String
  createdBy   User      @relation("InvitationCreateur", fields: [createdById], references: [id])
  usedById    String?   @unique
  usedBy      User?     @relation("InvitationUtilisateur", fields: [usedById], references: [id])
}

// Session côté serveur : cookie httpOnly contient un jeton aléatoire,
// seule son empreinte (SHA-256) est stockée (exigence 8.2).
model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rememberMe Boolean  @default(false)
  expireLe   DateTime
  createdAt  DateTime @default(now())
}

// F1.9 : traçabilité des connexions.
model LoginEvent {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @default(now())
  succes Boolean  @default(true)
}

// F1.6 : réinitialisation de mot de passe, lien valable 1 heure.
model PasswordReset {
  id        String    @id @default(cuid())
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expireLe  DateTime
  utiliseLe DateTime?
}

// F1.5 : double authentification par email du compte professeur (code à 6 chiffres).
model TwoFactorCode {
  id         String    @id @default(cuid())
  token      String    @unique
  codeHash   String
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expireLe   DateTime
  consommeLe DateTime?
  createdAt  DateTime  @default(now())
}

// F6.3 : paramètres du professeur (durée de validité des invitations, etc.).
model Setting {
  key   String @id
  value String
}

// ----- Phase 2 (F2 : gestion des cours) -----

// F2.1 — niveau 1 : la catégorie ("Cours débutant", "Cours avancé"...).
model Categorie {
  id        String   @id @default(cuid())
  titre     String
  ordre     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cours         Cours[]
  consultations Consultation[]
}

// F2.3 — niveau 2 : le cours unitaire. "publie" à false = en préparation (F2.6).
model Cours {
  id          String   @id @default(cuid())
  titre       String
  description String
  contenu     String   @default("") // markdown simple (titres, listes, gras)
  lienExterne String?
  publie      Boolean  @default(false)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categorieId String
  categorie   Categorie   @relation(fields: [categorieId], references: [id], onDelete: Cascade)
  fichiers   Fichier[]
  progressions Progression[]
}

// F2.3 — fichiers joints à un cours ou à un article de blog (PDF, images,
// documents bureautiques). Phase 3 : la pièce jointe est rattachée soit à
// un cours, soit à un article (les deux sont optionnels).
model Fichier {
  id        String   @id @default(cuid())
  nom       String // nom d'origine, affiché à l'élève
  nomStocke String // nom du fichier sur le disque (généré, sans risque)
  taille    Int
  estContenu Boolean @default(false) // phase 3 : image insérée dans le texte d'un article
  coursId   String?
  cours     Cours?   @relation(fields: [coursId], references: [id], onDelete: Cascade)
  articleId String?
  article   Article? @relation(fields: [articleId], references: [id], onDelete: Cascade)
  messageId String?
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ----- Phase 3 (F3 : blog d'accueil) -----

// F3.1 / F3.4 — article de blog affiché sur le dashboard.
// "publie" à false = brouillon ; "epingle" = "À la une" (F3.6).
model Article {
  id             String    @id @default(cuid())
  titre          String
  contenu        String    @default("") // markdown simple (titres, listes, gras, liens, images)
  imageNomStocke String? // image d'illustration optionnelle (F3.3)
  publie         Boolean   @default(false)
  epingle        Boolean   @default(false)
  publieLe       DateTime? // date de première publication, affichée sur les cartes
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  fichiers Fichier[]
}

// ----- Phase 4 (F4 : messagerie professeur / élève) -----

// F4.1 : conversation unique entre un élève et le professeur. Le champ
// eleveId identifie la conversation (un élève = une conversation, jamais
// entre élèves). "luLe" = date de lecture par le destinataire (F4.5) :
// null tant que le message n'a pas été ouvert.
model Message {
  id      String    @id @default(cuid())
  texte   String    @default("")
  auteurId String
  eleveId String
  luLe    DateTime?
  creeLe  DateTime  @default(now())

  auteur  User     @relation("MessageAuteur", fields: [auteurId], references: [id], onDelete: Cascade)
  eleve   User     @relation("MessageConversation", fields: [eleveId], references: [id], onDelete: Cascade)
  fichiers Fichier[]
}

// F2.3 / F2.4 — case "Cours terminé" cochée par l'élève.
model Progression {
  eleveId   String
  coursId   String
  termineLe DateTime @default(now())

  eleve User  @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  cours Cours @relation(fields: [coursId], references: [id], onDelete: Cascade)

  @@id([eleveId, coursId])
}

// F2.4 — suivi des catégories consultées, pour afficher la progression
// dans la catégorie la plus consultée par l'élève.
model Consultation {
  eleveId     String
  categorieId String
  nb          Int      @default(0)

  eleve     User      @relation(fields: [eleveId], references: [id], onDelete: Cascade)
  categorie Categorie @relation(fields: [categorieId], references: [id], onDelete: Cascade)

  @@id([eleveId, categorieId])
}
