# Modèle du .env.staging — à copier en .env.staging à la racine du dépôt
# sur le Raspberry Pi. JAMAIS dans Git. Staging = accès par tunnel SSH
# (port 3001), emails en mode console (pas de EMAIL_API_KEY).

TAG=latest

# Mot de passe distinct de la production : openssl rand -hex 24
POSTGRES_PASSWORD=a-remplacer-staging
