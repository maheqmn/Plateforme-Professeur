# Modèle du .env de production — à copier en .env À LA RACINE du dépôt cloné
# sur le Raspberry Pi. JAMAIS dans Git.

# Version déployée : tag Git (mis à jour automatiquement par deploy.sh).
TAG=latest

# Mot de passe PostgreSQL : générer une fois avec `openssl rand -hex 24`.
POSTGRES_PASSWORD=a-remplacer-par-un-secret-de-48-caracteres

# Service transactionnel Brevo (D5.3) : sans EMAIL_API_KEY, les emails
# restent journalisés en console (aucun envoi réel).
# La clé se crée sur brevo.com (SMTP & API → clés API) ; l'expéditeur doit
# être validé dans le compte Brevo.
EMAIL_API_KEY=
EMAIL_EXPEDITEUR=no-reply@galleriedearmelle.fr
EMAIL_EXPEDITEUR_NOM=Plateforme du professeur
